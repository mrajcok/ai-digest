# Environment
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
*.egg

# Virtual environment (project-local)
.venv/

# Logs — .jsonl/.err are autopilot's raw Claude stream and stderr; never commit them
logs/*.log
logs/*.jsonl
logs/*.err

# Runtime data (database, dry-run output) — the dir itself is tracked via .gitkeep
data/*
!data/.gitkeep

# Testing
.pytest_cache/
.coverage
htmlcov/

# Linting
.ruff_cache/

# Editors
.vscode/
.idea/
*.swp

# Claude Code
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db
