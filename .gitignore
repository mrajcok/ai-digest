# Environment
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
*.egg

# Virtual environment (project-local)
.venv/

# Logs — everything in here, so anything autopilot or a step drops in
# (filtered output, raw Claude stream, stderr) stays out of `git add -A`.
# The dir itself is tracked via .gitkeep, same as data/.
logs/*
!logs/.gitkeep

# Runtime data (database, dry-run output) — the dir itself is tracked via .gitkeep
data/*
!data/.gitkeep

# Testing
.pytest_cache/
.coverage
htmlcov/

# Linting
.ruff_cache/

# Editors
.vscode/
.idea/
*.swp

# Claude Code
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db
