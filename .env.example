OPENROUTER_API_KEY=sk-or-...
OPENROUTER_SUMMARIZATION_MODEL=google/gemma-3-27b-it
OPENROUTER_STAGE_SUMMARIZATION_MODEL=         # defaults to OPENROUTER_SUMMARIZATION_MODEL
SUMMARIZER_CONTENT_CHARS=15000   # chars of raw text sent to the summarization LLM

# Companies whose sites are firewall-blocked: the summary is all the reader gets,
# so it is longer and self-contained, built from a bigger slice of the article.
# Comma-separated company keys (not source keys) — see src/digest/sources.py.
LONG_SUMMARY_COMPANIES=anthropic,openai,mistral
SUMMARIZER_CONTENT_CHARS_LONG=30000
LONG_SUMMARY_TARGET_CHARS=1000   # target summary length for those companies, in characters

SQLITE_DB_PATH=data/ai_digest.db
GITHUB_TOKEN=ghp_...
GITHUB_REPO=username/ai-digest
GITHUB_PAGES_BRANCH=gh-pages
MAX_ARTICLE_AGE_DAYS=2
FEED_MAX_PAGES=10                # ?paged=N pages per feed; only used by --since backfill
INDEX_PAGE_LIMIT=10
LOG_LEVEL=INFO

# Autopilot run-summary email (autopilot.sh → autopilot_notify.py). Unset or
# false means autopilot sends nothing; a send failure never fails the run.
# Not read by the digest pipeline itself — these are for the autopilot harness.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587                # 465 switches to implicit SSL; anything else uses STARTTLS
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=                    # comma-separated

# Discord run-completion notification (on by default; set to false to disable)
DISCORD_NOTIFY=false
DISCORD_NOTIFY_METHOD=webhook            # "webhook" is the only supported method
DISCORD_WEBHOOK_URL=                     # required when method=webhook
