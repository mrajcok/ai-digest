<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>AI Digest — Daily AI News & Blog Roundup</title>
  <script>
    if (localStorage.getItem('theme') === 'light')
      document.documentElement.setAttribute('data-theme', 'light');
  </script>
  <style>
    :root {
      --bg:               #111;
      --surface:          #1e1e1e;
      --border:           #2e2e2e;
      --border-subtle:    #252525;
      --text:             #d4d4d4;
      --text-2:           #888;
      --text-3:           #555;
      --link:             #7ab3f5;
      --link-hover:       #a0c8ff;
      --tag-bg:           #2a2a2a;
      --tag-color:        #888;
      --section-color:    #666;
      --badge-anthropic-bg:   #d97757;
      --badge-anthropic-fg:   #fff;
      --badge-openai-bg:      #10a37f;
      --badge-openai-fg:      #fff;
      --badge-google-bg:      #4285f4;
      --badge-google-fg:      #fff;
      --badge-microsoft-bg:   #00a4ef;
      --badge-microsoft-fg:   #fff;
      --badge-aws-bg:         #ff9900;
      --badge-aws-fg:         #111;
      --badge-mistral-bg:     #fa500f;
      --badge-mistral-fg:     #fff;
      --badge-techcrunch-bg:  #0aab55;
      --badge-techcrunch-fg:  #fff;
      --badge-arstechnica-bg: #ff4e00;
      --badge-arstechnica-fg: #fff;
      --track-bg:            #444;
      --track-active:     #5a8de0;
      --thumb:            #bbb;
      --thumb-active:     #fff;
    }
    html[data-theme="light"] {
      --bg:               #fff;
      --surface:          #fff;
      --border:           #e0e0e0;
      --border-subtle:    #eee;
      --text:             #222;
      --text-2:           #666;
      --text-3:           #999;
      --link:             #0066cc;
      --link-hover:       #004499;
      --tag-bg:           #f0f0f0;
      --tag-color:        #555;
      --section-color:    #999;
      --track-bg:            #c8d8f0;
      --track-active:     #0066cc;
      --thumb:            #0066cc;
      --thumb-active:     #fff;
    }

    *, *::before, *::after { box-sizing: border-box; }
    body { font-family: system-ui, sans-serif; max-width: 900px; margin: 2rem auto; padding: 0 1rem; color: var(--text); background: var(--bg); }
    h1 { border-bottom: 2px solid var(--border); padding-bottom: .5rem; margin-bottom: 1rem; }
    .top-bar { display: flex; align-items: center; margin-bottom: 1.5rem; }
    .index-hint { flex: 1; font-size: .95rem; color: var(--text-2); margin: 0; }
    .index-hint a { color: var(--link); text-decoration: none; }
    .index-hint a:hover { color: var(--link-hover); }
    .company-links { font-size: .95rem; color: var(--text-2); margin: -.75rem 0 1.5rem; }
    .company-links a { color: var(--link); text-decoration: none; }
    .company-links a:hover { color: var(--link-hover); }
    h2.section { margin: 2rem 0 1rem; font-size: 1rem; color: var(--section-color); text-transform: uppercase; letter-spacing: .05em; border-bottom: 1px solid var(--border-subtle); padding-bottom: .25rem; }
    .card { border: 1px solid var(--border); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1rem; background: var(--surface); }
    .meta { font-size: .85rem; color: var(--text-2); margin-bottom: .4rem; }
    .badge { display: inline-block; padding: .15rem .5rem; border-radius: 4px; font-size: .75rem; font-weight: 600; margin-right: .4rem; text-decoration: none; }
    .badge:hover { opacity: .85; }
    .badge-anthropic   { background: var(--badge-anthropic-bg);   color: var(--badge-anthropic-fg); }
    .badge-openai      { background: var(--badge-openai-bg);      color: var(--badge-openai-fg); }
    .badge-google      { background: var(--badge-google-bg);      color: var(--badge-google-fg); }
    .badge-microsoft   { background: var(--badge-microsoft-bg);   color: var(--badge-microsoft-fg); }
    .badge-aws         { background: var(--badge-aws-bg);         color: var(--badge-aws-fg); }
    .badge-mistral     { background: var(--badge-mistral-bg);     color: var(--badge-mistral-fg); }
    .badge-techcrunch  { background: var(--badge-techcrunch-bg);  color: var(--badge-techcrunch-fg); }
    .badge-arstechnica { background: var(--badge-arstechnica-bg); color: var(--badge-arstechnica-fg); }
    .card h2 { margin: .25rem 0 .5rem; font-size: 1.05rem; }
    .card h2 a { color: var(--link); text-decoration: none; }
    .card h2 a:hover { color: var(--link-hover); text-decoration: underline; }
    .summary { font-size: .9rem; line-height: 1.5; color: var(--text-2); }
    .generated-at { font-size: .82rem; color: var(--text-3); margin: -.5rem 0 1.5rem; }
    .overview { border: 1px solid var(--border); border-radius: 6px; padding: 1.25rem 1.5rem; margin-bottom: 2rem; background: var(--surface); }
    .overview-heading { margin: 0 0 .35rem; font-size: 1.1rem; }
    .overview-meta { font-size: .82rem; color: var(--text-2); margin: 0 0 .75rem; }
    .overview-text { font-size: .95rem; line-height: 1.6; color: var(--text); }
    .scraper-summary { margin-top: 2.5rem; border-top: 2px solid var(--border); padding-top: 1rem; }
    .scraper-summary h2 { font-size: 1rem; color: var(--text-2); margin-bottom: 1rem; }
    .scraper-block { margin-bottom: 1.25rem; }
    .scraper-block h3 { font-size: .9rem; font-weight: 600; color: var(--text); margin: 0 0 .35rem; }
    .scraper-block ul { margin: 0 0 .5rem 1.25rem; padding: 0; font-size: .82rem; color: var(--text-2); }
    .scraper-block li { margin-bottom: .2rem; }
    .scraper-block .label { font-size: .75rem; font-weight: 600; text-transform: uppercase; letter-spacing: .05em; color: var(--text-3); margin: .4rem 0 .2rem; }


    /* theme toggle */
    .theme-toggle { display: flex; align-items: center; gap: .4rem; cursor: pointer; user-select: none; }
    .theme-toggle input { position: absolute; opacity: 0; width: 0; height: 0; }
    .track { width: 38px; height: 21px; background: var(--track-bg); border-radius: 21px; position: relative; transition: background .2s; flex-shrink: 0; }
    .track::after { content: ''; position: absolute; top: 3px; left: 3px; width: 15px; height: 15px; border-radius: 50%; background: var(--thumb); transition: transform .2s, background .2s; }
    .theme-toggle input:checked ~ .track { background: var(--track-active); }
    .theme-toggle input:checked ~ .track::after { transform: translateX(17px); background: var(--thumb-active); }
    .toggle-icon { font-size: .9rem; line-height: 1; }
  </style>
</head>
<body>
  <h1>AI Digest</h1>
  <p class="generated-at">Generated {{ generated_at }}</p>
  <div class="top-bar">
    <p class="index-hint">Showing the {{ index_per_company }} most recent from each vendor and the {{ index_per_company_press }} most recent from each press source — see each company's page for more.</p>
    <label class="theme-toggle" title="Toggle light/dark theme">
      <input type="checkbox" id="theme-chk">
      <span class="track"></span>
      <span class="toggle-icon" id="theme-icon">☀</span>
    </label>
  </div>
  <p class="company-links">
    {% for c, label in nav_companies %}<a href="{{ c }}/">{{ label }}</a>{% if not loop.last %} · {% endif %}{% endfor %}
  </p>

  {% macro card(r) %}
  <div class="card">
    <div class="meta">
      <a href="{{ r.company }}/" class="badge badge-{{ r.company }}">{{ company_labels[r.company] }}</a>
      <span>{{ r.category | replace("_", " ") }}</span>
      {% if r.published_date %}<span> · {{ r.published_date }}</span>{% endif %}
    </div>
    <h2><a href="{{ r.url }}" target="_blank" rel="noopener">{{ r.title | plaintitle }}</a></h2>
    {% if r.summary %}
    <div class="summary">{{ r.summary | markdown }}</div>
    {% endif %}
  </div>
  {% endmacro %}

  {% if overview %}
  <section class="overview">
    <h2 class="overview-heading">Today in AI{% if not overview_is_today %} — Overview for {{ overview.day }}{% endif %}</h2>
    <p class="overview-meta">{{ overview.day }} · {{ overview.article_count }} vendor source{{ "s" if overview.article_count != 1 else "" }} · vendor sources only</p>
    <div class="overview-text">{{ overview.text | markdown }}</div>
  </section>
  {% endif %}

  {% if not vendor_updates and not press_updates %}
  <p>No updates yet.</p>
  {% endif %}

  {% if vendor_updates %}
  <h2 class="section">Vendors</h2>
  {% for r in vendor_updates %}{{ card(r) }}{% endfor %}
  {% endif %}

  {% if press_updates %}
  <h2 class="section">Press</h2>
  {% for r in press_updates %}{{ card(r) }}{% endfor %}
  {% endif %}

  {% if scraper_infos %}
  <section class="scraper-summary">
    <h2>Coverage</h2>
    {% for info in scraper_infos %}
    <div class="scraper-block">
      <h3>{{ company_labels.get(info.company, info.company) }}</h3>
      <div class="label">Sources</div>
      <ul>
        {% for s in info.sources %}<li>{{ s }}</li>{% endfor %}
      </ul>
      <div class="label">Excluded</div>
      <ul>
        {% for e in info.exclusions %}<li class="excl">{{ e }}</li>{% endfor %}
      </ul>
      {% if info.known_issues %}
      <div class="label">Known issues</div>
      <ul>
        {% for k in info.known_issues %}<li class="excl">{{ k }}</li>{% endfor %}
      </ul>
      {% endif %}
    </div>
    {% endfor %}
  </section>
  {% endif %}

  <script>
    const chk = document.getElementById('theme-chk');
    const icon = document.getElementById('theme-icon');
    const saved = localStorage.getItem('theme') || 'dark';
    if (saved === 'light') { chk.checked = true; icon.textContent = '🌙'; }
    chk.addEventListener('change', function () {
      if (this.checked) {
        document.documentElement.setAttribute('data-theme', 'light');
        icon.textContent = '🌙';
        localStorage.setItem('theme', 'light');
      } else {
        document.documentElement.removeAttribute('data-theme');
        icon.textContent = '☀';
        localStorage.setItem('theme', 'dark');
      }
    });
  </script>
</body>
</html>
